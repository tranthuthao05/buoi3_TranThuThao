@model IEnumerable<buoi3_TranThuThao.Models.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";

    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}

<h2>Danh sách sản phẩm</h2>

<!-- Form tìm kiếm -->
<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text"
               name="searchString"
               value="@ViewBag.CurrentFilter"
               class="form-control"
               placeholder="Nhập mã, tên sản phẩm, mô tả hoặc danh mục..." />

        <button type="submit" class="btn btn-primary">
            Tìm kiếm
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Làm mới
        </a>
    </div>
</form>

<!-- Nút thêm sản phẩm -->
<p>
    <a asp-action="Create" class="btn btn-primary">
        Thêm sản phẩm
    </a>
</p>

<!-- Bảng sản phẩm -->
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ProductId</th>
            <th>ProductName</th>
            <th>Price</th>
            <th>Description</th>
            <th>CategoryName</th>
            <th>Chức năng</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Price</td>
                    <td>@item.Description</td>
                    <td>@item.Category?.Name</td>
                    <td>
                        <a asp-action="Details"
                           asp-route-id="@item.Id">Chi tiết</a> |

                        <a asp-action="Edit"
                           asp-route-id="@item.Id">Sửa</a> |

                        <a asp-action="Delete"
                           asp-route-id="@item.Id">Xóa</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">
                    Không tìm thấy sản phẩm nào!
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Thông tin số lượng -->
<p>
    Tổng số sản phẩm: <strong>@ViewBag.TotalProducts</strong>
</p>

<!-- Phân trang -->
@if (totalPages > 1)
{
    <nav>
        <ul class="pagination">

            <!-- Trang trước -->
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(currentPage - 1)"
                   asp-route-searchString="@ViewBag.CurrentFilter">
                    Trước
                </a>
            </li>

            <!-- Các số trang -->
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-searchString="@ViewBag.CurrentFilter">
                        @i
                    </a>
                </li>
            }

            <!-- Trang sau -->
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(currentPage + 1)"
                   asp-route-searchString="@ViewBag.CurrentFilter">
                    Sau
                </a>
            </li>

        </ul>
    </nav>
}
